package com.pages;

import org.openqa.selenium.By;
import org.openqa.selenium.Keys;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.interactions.Actions;
import org.openqa.selenium.support.FindBy;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.testng.Assert;


public class LabTestPage extends BasePage{
	
	WebDriver driver;
	
	@FindBy(xpath="//img[@src='/tests/public/icons/topcities/Pune.svg?1556796588']")
	WebElement city;
	
	@FindBy(xpath="//input[@placeholder='Search for Tests, Packages and Profiles']")
	WebElement test;
	
	public LabTestPage(WebDriver driver) {
		super(driver);
		this.driver=driver;
	}
	
	public void selectCity() {
		waitUntilWebElementIsVisible(city);
		waitUntilWebElementIsClickable(city);
		city.click();
	}
	
	public void clickSearchTest() {
		waitUntilWebElementIsVisible(test);
		waitUntilWebElementIsClickable(test);
		test.click();
	}
	
	public void enterTestName() {
		waitUntilWebElementIsVisible(test);
		waitUntilWebElementIsClickable(test);
		test.sendKeys("Hemo");
	}
	
	public void selectTestName() {
		try {
			Thread.sleep(2000);
		} catch (InterruptedException e) {
			
		}
		Actions action= new Actions(driver);
		action.sendKeys(Keys.ARROW_DOWN).build().perform();
		action.sendKeys(Keys.ARROW_DOWN).build().perform();
		action.sendKeys(Keys.ENTER).build().perform();
	}
	
	public void assertionOfTestSElection() {
		Assert.assertTrue(driver.getCurrentUrl().equals("https://www.practo.com/tests/haemoglobin-automated-blood/p?city=pune"), "Test Not Selected Properly");
	}
}
